model Feature {
  id          String    @id @default(uuid())
  name        String
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@map("features")
}

model Integration {
  id          String    @id @default(uuid())
  name        String
  description String?
  logo        String?
  url         String? 
  createdAt   DateTime  @default(now()) 
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@map("integrations")
}

model Submission {
  id          String          @id @default(uuid())
  toolData    Json
  status      SubmissionStatus @default(PENDING)
  reviewNote  String? 
  createdAt   DateTime        @default(now())
  reviewedAt  DateTime? 
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("submissions")
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

