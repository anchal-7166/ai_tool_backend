generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String?   @unique
  password      String
  firstName     String?
  lastName      String?
  avatar        String?
  bio           String?
  role          UserRole  @default(USER)
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  
  // User Preferences for Better Recommendations
  industry      String?                         // "Marketing", "Development", "Design"
  jobRole       String?                         // "Content Writer", "Developer", "Designer" 
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  lastLoginAt   DateTime?

  // Relations
  tools         Tool[]
  reviews       Review[]
  favorites     Favorite[]
  submissions   Submission[]
  // searchHistory SearchHistory[]
  collections   Collection[]
  toolViews     ToolView[]                      // Track what user viewed
  userPreferences UserPreference[]              // Personalized settings
  @@map("users")
}

enum UserRole {
  USER
  CREATOR
  ADMIN
  MODERATOR
}

model Tool {
  id              String      @id @default(uuid())
  name            String
  slug            String      @unique
  tagline         String
  description     String
  longDescription String?     @db.Text
  logo            String?
  websiteUrl      String?
  demoUrl         String?
  documentationUrl String?
  videoUrl        String?                       // Demo video
  status          ToolStatus  @default(PENDING)
  isPublished     Boolean     @default(false)
  isFeatured      Boolean     @default(false)
  isVerified      Boolean     @default(false)   // Verified by admin (quality badge)
  
  // Search & Discovery Fields
  searchKeywords  String[]                      // ["ai writing", "content generation", "blog"]
  aiModel         String?                       // "GPT-4", "Claude", "Llama 2", "Custom"
  releaseDate     DateTime?                     // When tool was launched
  lastUpdated     DateTime?                     // Last feature update
  
  // Technical Details for Filtering
  platformType    PlatformType[]                // [WEB, MOBILE, DESKTOP, API]
  // Target Audience (multi-select)
  targetAudience  TargetAudience[]              // [DEVELOPERS, MARKETERS, DESIGNERS]
  
  // Engagement Metrics
  viewCount       Int         @default(0)
  clickCount      Int         @default(0)
  favoriteCount   Int         @default(0)
  reviewCount     Int         @default(0)
  averageRating   Float       @default(0)
  weeklyViews     Int         @default(0)       //  Trending calculation
  monthlyViews    Int         @default(0)       //  Trending calculation
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  publishedAt     DateTime? 
  // Relations
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade) 
  categories      ToolCategory[]
  tags            ToolTag[]
  pricingPlans    PricingPlan[]
  screenshots     Screenshot[]
  reviews         Review[]
  favorites       Favorite[]
  features        Feature[]
  integrations    Integration[]
  
  // Enhanced Search Relations
  useCases        ToolUseCase[]                 // What problems it solves
  industries      ToolIndustry[]                // Which industries use it
  alternativeTo   Alternative[]     @relation("AlternativeFrom")
  alternatives    Alternative[]     @relation("AlternativeTo")
  comparisons     ToolComparison[]  @relation("ComparisonToolA")
  comparedWith    ToolComparison[]  @relation("ComparisonToolB")
  inCollections   CollectionTool[]
  toolViews       ToolView[]
  
  @@map("tools")
  @@index([slug])
  @@index([status])
  @@index([userId])
  @@index([isPublished, isFeatured])  //  Fast featured tools query
  @@index([averageRating])             //  Sort by rating
  @@index([weeklyViews])               //  Trending tools
  @@index([name])
  @@index([tagline])
}


model Favorite {
  id     String @id @default(uuid())
  userId String
  toolId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool Tool @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  @@unique([userId, toolId]) 
}

enum ToolStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

//  Platform Types (where tool runs)
enum PlatformType {
  WEB           // Browser-based
  MOBILE_IOS    // iPhone/iPad app
  MOBILE_ANDROID // Android app
  DESKTOP_MAC   // macOS app
  DESKTOP_WINDOWS // Windows app
  DESKTOP_LINUX // Linux app
  API           // API access only
  CLI           // Command line tool
  BROWSER_EXTENSION // Chrome/Firefox extension
}


//  Target Audience
enum TargetAudience {
  DEVELOPERS
  MARKETERS
  DESIGNERS
  WRITERS
  SALES_TEAMS
  CUSTOMER_SUPPORT
  DATA_ANALYSTS
  PRODUCT_MANAGERS
  STUDENTS
  RESEARCHERS
  BUSINESS_OWNERS
  HR_RECRUITERS
}

// ==================== USE CASES (Problem -> Solution) ====================

/**
 * UseCase Model - What problems can be solved
 * 
 * Examples:
 * - "Generate blog posts from keywords"
 * - "Create product descriptions"
 * - "Translate documents"
 * - "Generate code from natural language"
 * - "Summarize long articles"
 * - "Create marketing copy"
 * 
 * Search: "I need to write blog posts faster"
 * → Shows tools with "Generate blog posts" use case
 */
model UseCase {
  id          String    @id @default(uuid())
  title       String    @unique           // "Generate blog posts"
  description String?                     // "Create SEO-optimized blog content in minutes"
  slug        String    @unique           // "generate-blog-posts"
  icon        String?                     // 
  createdAt   DateTime  @default(now()) 
  // Relations
  tools       ToolUseCase[]
  @@map("use_cases")
  @@index([slug])
}

model ToolUseCase {
  toolId      String
  useCaseId   String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  useCase     UseCase   @relation(fields: [useCaseId], references: [id], onDelete: Cascade)
  @@id([toolId, useCaseId])
  @@map("tool_use_cases")
}

// ==================== INDUSTRIES ====================

/**
 * Industry Model - Which industries/verticals use the tool
 * 
 * Examples:
 * - "E-commerce" → Product description generators
 * - "Legal" → Contract analysis AI
 * - "Healthcare" → Medical diagnosis assistants
 * - "Real Estate" → Property description generators
 * - "Education" → Learning assistants
 * 
 * Filter: "Show me AI tools for E-commerce"
 */
model Industry {
  id          String    @id @default(uuid())
  name        String    @unique           // "E-commerce"
  slug        String    @unique           // "e-commerce"
  description String?
  icon        String?                     // "🛒"
  createdAt   DateTime  @default(now())
  // Relations
  tools       ToolIndustry[] 
  @@map("industries")
}

model ToolIndustry {
  toolId      String
  industryId  String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  industry    Industry  @relation(fields: [industryId], references: [id], onDelete: Cascade)
  
  @@id([toolId, industryId])
  @@map("tool_industries")
}

/**
 * Enhanced Category with hierarchy support
 */
model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  icon        String?
  color       String?
  order       Int       @default(0) 
  // Hierarchy Support
  parentId    String?                     // For subcategories
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy") 
  // SEO & Discovery
  metaTitle   String?
  metaDescription String? 
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt 
  // Relations
  tools       ToolCategory[]
  @@map("categories")
  @@index([parentId])
}


model ToolCategory {
  toolId      String
  categoryId  String
  isPrimary   Boolean   @default(false)   // One primary category
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  @@id([toolId, categoryId])
  @@map("tool_categories")
}


model Tag {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  // Popularity tracking
  usageCount  Int       @default(0)       // How many tools use this tag
  createdAt   DateTime  @default(now())
  // Relations
  tools       ToolTag[]
  @@map("tags")
  @@index([usageCount])  // Popular tags first
}

model ToolTag {
  toolId    String
  tagId     String
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  tag       Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@id([toolId, tagId])
  @@map("tool_tags")
}

model PricingPlan {
  id          String       @id @default(uuid())
  name        String
  type        PricingType
  price       Float?
  currency    String       @default("USD")
  billingCycle BillingCycle?
  description String?
  features    String[] 
  // Detailed Pricing Info
  trialDays   Int?                        // Free trial period
  minSeats    Int?                        // Minimum users (for team plans)
  maxSeats    Int?                        // Maximum users 
  // Usage Limits
  monthlyRequests Int?                    // API calls per month
  storageLimit    Int?                    // GB of storage
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt 
  toolId      String
  tool        Tool         @relation(fields: [toolId], references: [id], onDelete: Cascade)  
  @@map("pricing_plans")
}

enum PricingType {
  FREE
  FREEMIUM
  PAID
  SUBSCRIPTION
  ONE_TIME
  USAGE_BASED    // Pay per use
  CUSTOM
}

enum BillingCycle {
  MONTHLY
  YEARLY
  LIFETIME
  PAY_AS_YOU_GO  // Usage-based
}

