/**
 * PopularSearch - Track trending searches
 * Aggregated daily to show "Popular searches today"
 */
model PopularSearch {
  id          String    @id @default(uuid())
  query       String    @unique
  searchCount Int       @default(1)
  lastSearched DateTime @default(now()) 
  @@map("popular_searches")
  @@index([searchCount])
  @@index([lastSearched])
}

// ==================== USER PREFERENCES & RECOMMENDATIONS ====================

/**
 * UserPreference - Personalized settings for better search
 * 
 * Example:
 * User always filters for:
 * - Free tools only
 * - Privacy-focused (on-premise)
 * - For marketing use
 * 
 * System auto-applies these preferences
 */
model UserPreference {
  id          String    @id @default(uuid()) 
  // Default Filters
  preferredPricing PricingType[]         // Auto-filter to free/paid
  preferredPlatforms PlatformType[]      // Show web/mobile tools 
  // Personalization
  interests   String[]                    // ["writing", "design", "marketing"]
  hideTools   String[]                    // Tool IDs to hide
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("user_preferences")
}

/**
 * ToolView - Track what users view (for recommendations)
 * "Users who viewed this also viewed..."
 */
model ToolView {
  id          String    @id @default(uuid()) 
  userId      String?                     // null for anonymous
  ipAddress   String?                     // IP address for deduplicating anonymous views
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  toolId      String
  tool        Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  // Engagement tracking
  duration    Int?                        // Seconds spent on page
  scrollDepth Int?                        // Percentage scrolled
  clickedDemo Boolean   @default(false)   // Clicked "Try Demo"
  clickedWebsite Boolean @default(false)  // Clicked "Visit Website"
  viewedAt    DateTime  @default(now())
  
  @@map("tool_views")
  @@index([userId])
  @@index([ipAddress])
  @@index([toolId])
  @@index([viewedAt])
}

// ==================== COLLECTIONS & CURATION ====================

/**
 * Collection - Curated lists of tools
 * 
 * Examples:
 * - "Best Free AI Writing Tools 2024"
 * - "AI Tools for E-commerce"
 * - "Privacy-First AI Tools"
 * - "AI Tools Under $20/month"
 * 
 * Users can create and share collections
 */
model Collection {
  id          String    @id @default(uuid())
  title       String
  slug        String    @unique
  description String?   @db.Text
  isPublic    Boolean   @default(true)
  isFeatured  Boolean   @default(false)   // Admin-curated
  viewCount   Int       @default(0)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tools       CollectionTool[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  @@map("collections")
  @@index([slug])
  @@index([userId])
  @@index([isFeatured])
}

model CollectionTool {
  collectionId String
  toolId       String
  order        Int       @default(0)       // Order in collection
  note         String?                     // Why it's in the collection 
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  tool         Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  addedAt      DateTime   @default(now())
  @@id([collectionId, toolId])
  @@map("collection_tools")
}

// ==================== TOOL COMPARISON ====================

/**
 * ToolComparison - Compare tools side-by-side
 * Track popular comparisons for SEO and discovery
 * 
 * Example:
 * "ChatGPT vs Claude vs Gemini"
 */
model ToolComparison {
  id          String    @id @default(uuid()) 
  toolAId     String
  toolBId     String 
  toolA       Tool      @relation("ComparisonToolA", fields: [toolAId], references: [id], onDelete: Cascade)
  toolB       Tool      @relation("ComparisonToolB", fields: [toolBId], references: [id], onDelete: Cascade)
  viewCount   Int       @default(0)
  createdAt   DateTime  @default(now())
  @@unique([toolAId, toolBId])
  @@map("tool_comparisons")
  @@index([viewCount])  // Popular comparisons
}

/**
 * Alternative - "Similar to" / "Alternative to" relationships
 * 
 * Example:
 * ChatGPT alternatives: Claude, Gemini, Llama
 */
model Alternative {
  id          String    @id @default(uuid())
  toolId      String                      // Main tool
  alternativeId String                    // Alternative tool
  tool        Tool      @relation("AlternativeFrom", fields: [toolId], references: [id], onDelete: Cascade)
  alternative Tool      @relation("AlternativeTo", fields: [alternativeId], references: [id], onDelete: Cascade)
  similarity  Float     @default(0.0)     // 0-1 similarity score
  reason      String?                     // "Similar features but cheaper"
  createdAt   DateTime  @default(now())
  @@unique([toolId, alternativeId])
  @@map("alternatives")
}


model Screenshot {
  id        String    @id @default(uuid())
  url       String
  caption   String?
  order     Int       @default(0)
  createdAt DateTime  @default(now())
  toolId    String
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  @@map("screenshots")
}

model Review {
  id        String    @id @default(uuid())
  rating    Int
  title     String?
  comment   String    @db.Text
  isVerified Boolean  @default(false)
  isHelpful  Int      @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade) 
  @@unique([userId, toolId])
  @@map("reviews")
}

